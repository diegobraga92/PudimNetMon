# Builds the Kafka storage consumer (pudim-consumer-storage)
# Check https://hub.docker.com/_/ubuntu/tags
FROM ubuntu:24.04 AS builder

RUN apt-get update && apt-get install -y -qq \
    cmake protobuf-compiler libprotobuf-dev libgrpc++-dev \
    libgrpc-dev protobuf-compiler-grpc build-essential \
    pkg-config git ca-certificates \
    libpq-dev librdkafka-dev

WORKDIR /build
COPY collector/ ./collector/
# The collector CMakeLists references agent sources (tls_credentials.cpp,
# metrics_client.cpp) during configuration even when only building consumers,
# so the agent tree must be present in the build context.
COPY agent/ ./agent/
COPY api/ ./api/

RUN cmake -S collector -B build && \
    cmake --build build -j$(nproc) --target pudim-consumer-storage && \
    cp build/pudim-consumer-storage /usr/local/bin/

FROM ubuntu:24.04

RUN apt-get update && apt-get install -y -qq \
    libprotobuf32t64 libgrpc++1.51t64 \
    libpq5 librdkafka1 librdkafka++1 && \
    rm -rf /var/lib/apt/lists/*

COPY --from=builder /usr/local/bin/pudim-consumer-storage /usr/local/bin/

# The compose file passes the full command (binary + flags) explicitly.
ENTRYPOINT []
CMD []
