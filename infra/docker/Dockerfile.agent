# Check https://hub.docker.com/_/ubuntu/tags
FROM ubuntu:24.04 AS builder

RUN apt-get update && apt-get install -y -qq \
    cmake protobuf-compiler libprotobuf-dev libgrpc++-dev \
    libgrpc-dev protobuf-compiler-grpc build-essential \
    pkg-config git ca-certificates \
    libcurl4-openssl-dev libssl-dev libpcap-dev libsystemd-dev libsqlite3-dev

WORKDIR /build
COPY agent/ ./agent/
COPY api/ ./api/

# Build the agent with gRPC/protobuf/abseil linked statically so the staged
# binary runs on any Debian/Ubuntu release
RUN cmake -S agent -B build -DPUDIM_STATIC_GRPC=ON && \
    cmake --build build -j$(nproc) && \
    cp build/pudim-agent /usr/local/bin/pudim-agent

FROM ubuntu:24.04

# The agent bundles gRPC/protobuf/abseil, so the runtime only needs the stable
# dynamic deps
RUN apt-get update && apt-get install -y -qq \
    libcurl4t64 libssl3t64 libpcap0.8t64 libsystemd0 libsqlite3-0 \
    traceroute tcpdump && \
    rm -rf /var/lib/apt/lists/*

COPY --from=builder /usr/local/bin/pudim-agent /usr/local/bin/pudim-agent

ENTRYPOINT ["/usr/local/bin/pudim-agent"]
CMD ["--collector-endpoint=collector:50051", "--node-id=agent-docker", "--interval=5000"]