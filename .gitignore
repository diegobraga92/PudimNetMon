# Build artifacts (C++ agent & collector)
agent/build/
collector/build/
build-agent/
build-collector/
build-collector-debug/

# Dependencies fetched by CMake FetchContent (inside ignored build dirs,
# listed here for clarity)
**/_deps/

# CMake generated artifacts (incl. accidental in-source builds)
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
CTestTestfile.cmake
CMakeUserPresets.json

# CMake generated exports
compile_commands.json

# Core dumps (from crash debugging)
core
core.*

# Node.js / dashboard
node_modules/
dashboard/dist/
*.tsbuildinfo
.vite/

# Python (used for local dev/mock scripts)
__pycache__/
*.py[cod]

# IDE / editor
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Logs
*.log

# Environment / secrets
.env
.env.*
!.env.example