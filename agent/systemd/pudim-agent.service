[Unit]
Description=PudimNetMon Agent - Network monitoring heartbeat daemon
Documentation=https://github.com/diegobraga92/PudimNetMon
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=main
WatchdogSec=60
# Settings are layered: built-in defaults < /etc/pudim/agent.conf < flags below.
# Copy agent/config/agent.conf.example to /etc/pudim/agent.conf and edit it to
# configure endpoints, probe targets, mTLS, buffering, etc. --node-id=%H is
# host-specific so it stays here; pass --config-file=<path> to override the
# default config location (explicit paths must exist).
ExecStart=/usr/local/bin/pudim-agent \
    --node-id=%H

# Security hardening: run unprivileged and retain only the capabilities the
# probes need (CAP_NET_RAW for ICMP raw sockets, CAP_NET_ADMIN for libpcap).
User=nobody
Group=nogroup
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_ADMIN

# Resource limits
LimitNOFILE=65536
MemoryMax=256M
CPUQuota=50%

# Log rotation / journald: stdout+stderr captured and rotated by journald
StandardOutput=journal
StandardError=journal
JournaldStreamRateIntervalSec=10

# Restart behavior
Restart=always
RestartSec=5
StartLimitInterval=300
StartLimitBurst=3

[Install]
WantedBy=multi-user.target