# clangd configuration for PudimNetMon.
#
# clangd resolves the generated protobuf/gRPC headers (metrics.pb.h, etc.)
# through the compile_commands.json symlinks placed in collector/ and agent/,
# which point at the CMake build directories (see CMakeLists.txt).
#
# The *.pb.h / *.pb.cc files are generated by protoc/gRPC and live inside the
# build directories; suppress all clangd diagnostics inside them so they never
# show up as red squiggles.
If:
  PathMatch: .*\.pb\.(h|cc)$
  Diagnostics:
    Suppress: all
