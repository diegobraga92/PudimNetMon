# clangd config for PudimNetMon.
# compile_commands.json symlinks in collector/ and agent/ point at the CMake
# build dirs, so clangd resolves generated protobuf/gRPC headers.
# The generated *.pb.h/*.pb.cc files live in build dirs. Suppress diagnostics there.
If:
  PathMatch: .*\.pb\.(h|cc)$
  Diagnostics:
    Suppress: all
If:
  PathMatch: .*\.pb\.(h|cc)$
  Diagnostics:
    Suppress: all
