# PudimNetMon — Host Port Configuration
# Copy this file to .env and adjust the HOST-side ports to avoid conflicts
# with other services already running on the LAN server (or your machine).
#
#   cp .env.example .env
#   $EDITOR .env
#   docker compose up --build
#
# Only the host-side port (left of the colon) is configurable. The container
# ports stay fixed — Docker remaps them automatically, so no application
# code, nginx.conf, or inter-service URLs need to change.

# Dashboard (React/TS web UI) — user-facing
PUDIM_DASHBOARD_PORT=3000

# Grafana — metrics dashboards (internally listens on :3000)
PUDIM_GRAFANA_PORT=3100

# Collector — HTTP REST API + health endpoints
PUDIM_COLLECTOR_HTTP_PORT=8080

# Collector — gRPC (agent heartbeats + metrics)
PUDIM_COLLECTOR_GRPC_PORT=50051

# Collector-secondary — HTTP (DR standby)
PUDIM_COLLECTOR_SECONDARY_HTTP_PORT=8081

# Collector-secondary — gRPC (DR standby)
PUDIM_COLLECTOR_SECONDARY_GRPC_PORT=50052

# TimescaleDB — PostgreSQL
PUDIM_TIMESCALEDB_PORT=5432

# Kafka — bootstrap broker (PLAINTEXT listener)
PUDIM_KAFKA_PORT=9092

# Consumer-storage — Prometheus /metrics endpoint
PUDIM_CONSUMER_STORAGE_PROMETHEUS_PORT=9091

# Consumer-alert — Prometheus /metrics endpoint
PUDIM_CONSUMER_ALERT_PROMETHEUS_PORT=9093
